      "refresh": { "name": "Refresh" }
    },
    "select": {
      "mode": {
        "name": "Mode",
        "state": { "auto": "Automatic", "manual": "Manual" }
      }
    },
    "time": {
      "start": { "name": "Light start" },
      "end": { "name": "Light end" }
    }
  }
