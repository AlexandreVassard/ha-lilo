      "user": {
        "description": "Choose the Lilo to add.",
        "data": { "address": "Device" }
      },
      "bluetooth_confirm": {
        "description": "Add {name}?"
      }
    },
    "abort": {
      "already_configured": "This Lilo is already configured.",
